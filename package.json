{
  "name": "payin-automation",
  "version": "1.0.0",
  "description": "Automated testing for fintech pay-in routing logic",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node src/auto-run.js",
    "format": "npx prettier --write \"src/**/*.js\"",
    "test:unified": "node -e \"require('./src/tests/unified-routing-test').testUnifiedRouting().then(() => process.exit(0)).catch(() => process.exit(1))\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.0"
  }
}
